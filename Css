body {
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.calculator {
  background: rgb(0, 0, 0);
  border-radius: 10px;
  box-shadow: 0 5px 10px rgb(255, 0, 0);
  width: 300px;
}

#display {
  width: 100%;
  height: 60px;
  border: none;
  text-align: right;
  font-size: 2rem;
  padding: 10px;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  outline: none;
  box-sizing: border-box;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  padding: 20px;
}

button {
  height: 50px;
  font-size: 1.5rem;
  border: none;
  border-radius: 6px;
  background-color: #00ff40;
  cursor: pointer;
  transition: background-color 0.3s;
}

button:hover {
  background-color: #00d9ff;
}

.equals {
  background-color: #0019f5;
  color: white;
  grid-column: span 2;
}

.equals:hover {
  background-color: #0077e6;
}
